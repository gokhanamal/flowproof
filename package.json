    "validate": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@openai/agents": "0.13.5",
    "fast-xml-parser": "5.10.1",
    "webdriverio": "9.29.1",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "appium": "3.5.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
