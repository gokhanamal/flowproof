{
  "name": "@gokhanamal/openai-appium-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded OpenAI Agents SDK runner for iOS Appium journeys",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "smoke:appium": "tsx src/smoke.ts",
